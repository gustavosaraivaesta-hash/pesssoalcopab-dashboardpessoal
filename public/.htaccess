# Apache config para SPA React em /dashboardpessoal/
# Coloque o conteúdo de /dist em /var/www/html/dashboardpessoal/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /dashboardpessoal/

  # Não reescrever arquivos ou pastas existentes (assets, imagens, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota cai no index.html (React Router cuida)
  RewriteRule . /dashboardpessoal/index.html [L]
</IfModule>

# Compressão (opcional, recomendado)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache de assets com hash (Vite gera nomes versionados)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Tipos MIME modernos
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json
</IfModule>
